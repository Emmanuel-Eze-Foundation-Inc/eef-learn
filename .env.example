# ============================================================================
# EEF Learn — environment
# Copy to .env and adjust. Defaults work with `docker compose up` and NO API keys.
# Full reference: docs/self-hosting.md
# ============================================================================

# --- Database (docs/self-hosting.md#database) -------------------------------
# docker-compose provides postgres with pgvector at this URL.
DATABASE_URL=postgresql://eef:eef@localhost:5432/eef_learn

# --- Service auth (docs/self-hosting.md#service-auth) ------------------------
# Shared bearer secret between web and the AI service. Any random string;
# must be identical in both services. Rotate via AI_SERVICE_TOKEN_NEXT overlap.
AI_SERVICE_TOKEN=dev-local-token
# AI_SERVICE_TOKEN_NEXT=
AI_SERVICE_URL=http://localhost:8000

# --- Auth (docs/self-hosting.md#auth) ----------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me-0123456789
# Email verification: "on" (default) sends links (console-logged in dev, Mailpit
# in docker-compose). Self-hosters can set "off" to skip entirely.
AUTH_EMAIL_VERIFICATION=on
# Public URL of the web app (used for auth callbacks + email links).
AUTH_URL=http://localhost:3000
# Extra origins for auth cookies (comma-separated). Optional. Use for Vercel previews.
# AUTH_TRUSTED_ORIGINS=https://eef-learn-git-dev.vercel.app
# SMTP for outbound email. docker-compose Mailpit: smtp://localhost:1025
# Unset = emails are logged to the web server console (fine for dev).
# SMTP_URL=smtp://localhost:1025
EMAIL_FROM=EEF Learn <no-reply@eeflearn.local>
# Google OAuth auto-enables ONLY when both are present (optional for self-hosters).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI provider (docs/self-hosting.md#ai-providers) --------------------------
# EEF Learn provides no AI credits and holds no model key. Creators bring their
# own: a key (OpenRouter, OpenAI, Anthropic or Google, encrypted at rest) in
# Settings, or their own AI client over MCP. No usage limits apply.
#
# mock (default): keyless users get deterministic canned maps — zero spend.
# anything else: real models only; keyless users are asked to connect their AI.
AI_PROVIDER=mock
AI_MODEL=mock-model

# Per-task routing for creators on OpenRouter with no model chosen (each falls
# back to AI_MODEL; OpenRouter ids). Example:
# AI_MODEL_SKELETON=anthropic/claude-sonnet-4.5   # graph structure: strong model
# AI_MODEL_SECTION=anthropic/claude-sonnet-4.5    # lesson content: strong model
# AI_MODEL_CHAT=google/gemini-flash               # companion bot: fast + cheap
# AI_MODEL_ENRICH=google/gemini-flash             # source enrichment: cheapest

# --- Embeddings ---------------------------------------------------------------
# Dimension is stored with vectors; switching providers triggers a re-embed job.
EMBEDDINGS_MODEL=mock-embeddings
EMBEDDINGS_DIMENSIONS=768

# --- Error reports (optional; off when unset) ---------------------------------
# Sentry. The DSN is public by design; the auth token (source maps) is a secret.
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# AI service:
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production

# --- Optional integrations ----------------------------------------------------
# YouTube Data API (enrichment runs without it, using cached/mock data)
# YOUTUBE_API_KEY=

# Paid block registries for local studio reference only. Never commit values.
# SHADCNBLOCKS_API_KEY=
# ACETERNITY_API_KEY=
