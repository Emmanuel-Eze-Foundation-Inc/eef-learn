# ============================================================================
# EEF Learn — environment
# Copy to .env and adjust. Defaults work with `docker compose up` and NO API keys.
# Full reference: docs/self-hosting.md
# ============================================================================

# --- Database (docs/self-hosting.md#database) -------------------------------
# docker-compose provides postgres with pgvector at this URL.
DATABASE_URL=postgresql://eef:eef@localhost:5432/eef_learn

# --- Service auth (docs/self-hosting.md#service-auth) ------------------------
# Shared bearer secret between web and the AI service. Any random string;
# must be identical in both services. Rotate via AI_SERVICE_TOKEN_NEXT overlap.
AI_SERVICE_TOKEN=dev-local-token
# AI_SERVICE_TOKEN_NEXT=
AI_SERVICE_URL=http://localhost:8000

# --- Auth (docs/self-hosting.md#auth) ----------------------------------------
# Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-secret-change-me-0123456789
# Email verification: "on" (default) sends links (console-logged in dev, Mailpit
# in docker-compose). Self-hosters can set "off" to skip entirely.
AUTH_EMAIL_VERIFICATION=on
# Google OAuth auto-enables ONLY when both are present (optional for self-hosters).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- AI provider (docs/self-hosting.md#ai-providers) --------------------------
# The SAME variables configure both web and the AI service. One config, no dual setup.
#
# mock (default): deterministic canned maps/content — zero keys, zero spend.
# openrouter (hosted default): per-task model routing below.
# openai | anthropic | google | openai-compatible (e.g. Ollama via AI_BASE_URL).
AI_PROVIDER=mock
AI_MODEL=mock-model
# AI_API_KEY=
# AI_BASE_URL=            # e.g. http://localhost:11434/v1 for Ollama

# Per-task model routing (each falls back to AI_MODEL). Example OpenRouter setup:
# AI_MODEL_SKELETON=anthropic/claude-sonnet-4.5   # graph structure: strong model
# AI_MODEL_SECTION=anthropic/claude-sonnet-4.5    # lesson content: strong model
# AI_MODEL_CHAT=google/gemini-flash               # companion bot: fast + cheap
# AI_MODEL_ENRICH=google/gemini-flash             # source enrichment: cheapest

# --- Embeddings ---------------------------------------------------------------
# Dimension is stored with vectors; switching providers triggers a re-embed job.
EMBEDDINGS_MODEL=mock-embeddings
EMBEDDINGS_DIMENSIONS=768

# --- Optional integrations ----------------------------------------------------
# YouTube Data API (enrichment runs without it, using cached/mock data)
# YOUTUBE_API_KEY=
