// EEF Learn — data layer (PLAN.md M1)
// pgvector: enabled via migration `CREATE EXTENSION IF NOT EXISTS vector`.
// GenerationJob dedup: partial unique index added in raw SQL migration:
//   CREATE UNIQUE INDEX generation_job_dedup ON "GenerationJob"(map_id, node_id, block_index)
//   WHERE status IN ('queued','running');

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum Role {
  user
  admin
}

enum MapVisibility {
  private
  unlisted
  public
}

enum SourcePolicy {
  stick_to_doc
  augment
}

enum BlockType {
  youtube
  blog
  ai_text
  pdf_extract
  flashcard
  quiz
  video
  image
  audio
  embed
  code
  resource
}

enum JobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AccessStatus {
  pending
  approved
  declined
}

enum ProposalStatus {
  pending
  accepted
  rejected
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String   @default("")
  image         String? // https URL from Google, or a small data: URL uploaded in settings
  headline      String   @default("")
  bio           String   @default("")
  location      String   @default("")
  website       String   @default("")
  role          Role     @default(user)
  birthdate     DateTime? // 13+ gate enforced at email signup; collected before Google
  aiKeyCipher   String? // the user's own model key, AES-GCM; never returned to the client
  aiKeyProvider String? // openrouter | openai | anthropic | google
  aiKeyModel    String? // optional model id; the provider's default when null
  learningPathPublic Boolean @default(false) // shows /people/:id with the public maps they're on
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  maps             Map[]
  progress         Progress[]
  threads          CompanionThread[]
  generationJobs   GenerationJob[]
  updateProposals  UpdateProposal[]  @relation("proposalLearner")
  coffeeChatRequests CoffeeChatRequest[]
  mapAccess          MapAccess[]

  oauthClients       OauthClient[]
  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]
  oauthConsents      OauthConsent[]

  @@index([email])
}

// --- Better Auth tables ---

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  oauthRefreshTokens OauthRefreshToken[]
  oauthAccessTokens  OauthAccessToken[]

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// --- OAuth for MCP clients (Better Auth jwt + mcp plugins) ---

model Jwks {
  id         String    @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
  alg        String?
  crv        String?
}

model OauthClient {
  id                               String    @id @default(cuid())
  clientId                         String    @unique
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?  @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String[]
  clientCredentialsScopes          String[]  @default([])
  userId                           String?
  createdAt                        DateTime? @default(now())
  updatedAt                        DateTime? @updatedAt
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String[]
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String[]
  postLogoutRedirectUris           String[]
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String[]
  responseTypes                    String[]
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?  @default(false)
  referenceId                      String?
  metadata                         Json?

  user          User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resources     OauthClientResource[]
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
}

model OauthResource {
  id                            String    @id @default(cuid())
  identifier                    String    @unique
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String[]
  customClaims                  Json?
  dpopBoundAccessTokensRequired Boolean?  @default(false)
  disabled                      Boolean?  @default(false)
  createdAt                     DateTime? @default(now())
  updatedAt                     DateTime? @updatedAt
  policyVersion                 Int?      @default(1)
  metadata                      Json?

  clients OauthClientResource[]
}

model OauthClientResource {
  id         String    @id @default(cuid())
  clientId   String
  resourceId String
  metadata   Json?
  createdAt  DateTime? @default(now())

  client   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)

  @@index([clientId])
  @@index([resourceId])
}

model OauthRefreshToken {
  id                      String    @id @default(cuid())
  token                   String    @unique
  clientId                String
  sessionId               String?
  userId                  String
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  expiresAt               DateTime?
  createdAt               DateTime? @default(now())
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            Json?
  scopes                  String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
}

model OauthAccessToken {
  id                      String    @id @default(cuid())
  token                   String?   @unique
  clientId                String
  sessionId               String?
  userId                  String?
  referenceId             String?
  authorizationCodeId     String?
  resources               String[]
  requestedUserInfoClaims String[]
  refreshId               String?
  expiresAt               DateTime?
  createdAt               DateTime? @default(now())
  revoked                 DateTime?
  confirmation            Json?
  scopes                  String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
}

model OauthConsent {
  id                      String    @id @default(cuid())
  clientId                String
  userId                  String?
  referenceId             String?
  resources               String[]
  requestedUserInfoClaims String[]
  scopes                  String[]
  createdAt               DateTime? @default(now())
  updatedAt               DateTime? @updatedAt

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime
}

model Map {
  id                 String        @id @default(cuid())
  slug               String        @unique
  title              String
  topic              String
  version            Int           @default(1)
  visibility         MapVisibility @default(private)
  sourcePolicy       SourcePolicy  @default(augment)
  generationEnabled  Boolean       @default(true)
  regenerationEnabled Boolean      @default(true)
  brief              Json? // interview answers: audience, startingPoint, depth, notes
  creatorId          String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  creator        User             @relation(fields: [creatorId], references: [id])
  nodes          Node[]
  edges          Edge[]
  progress       Progress[]
  threads        CompanionThread[]
  generationJobs GenerationJob[]
  // composition: this map as parent (built on components) and as component (used by parents)
  components     MapComposition[] @relation("parentMap")
  usedIn         MapComposition[] @relation("componentMap")
  coffeeChatRequests CoffeeChatRequest[]
  access             MapAccess[]

  @@index([creatorId])
  @@index([visibility])
}

model Node {
  id        String   @id @default(cuid())
  mapId     String
  slug      String // stable across regenerations
  title     String
  order     Int
  parentId  String?
  positionX Float?
  positionY Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map           Map            @relation(fields: [mapId], references: [id], onDelete: Cascade)
  parent        Node?          @relation("NodeTree", fields: [parentId], references: [id], onDelete: SetNull)
  children      Node[]         @relation("NodeTree")
  contentBlocks ContentBlock[]
  progress      Progress[]
  edgesFrom     Edge[]         @relation("edgeFrom")
  edgesTo       Edge[]         @relation("edgeTo")

  @@unique([mapId, slug])
  @@index([mapId])
  @@index([parentId])
}

model Edge {
  id        String   @id @default(cuid())
  mapId     String
  fromId    String
  toId      String
  kind      String   @default("prerequisite")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  map  Map  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  from Node @relation("edgeFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Node @relation("edgeTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([mapId, fromId, toId, kind])
  @@index([mapId])
}

model ContentBlock {
  id         String    @id @default(cuid())
  nodeId     String
  blockIndex Int
  type       BlockType
  title      String?
  body       String? // ai_text body / blog metadata JSON / pdf extract
  url        String? // youtube/blog canonical URL (validated, SSRF-hardened at write time)
  durationSeconds Int? // real media length when known (looked up at write time); drives time estimates
  optional        Boolean @default(false) // deep dive: counted apart from the lesson's core time
  // provenance (ai_text): model id, prompt hash, source block ids
  provenanceModel      String?
  provenancePromptHash String?
  provenanceSourceIds  String[]
  mapVersion Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  node         Node          @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  attributions Attribution[]

  @@unique([nodeId, blockIndex, mapVersion])
  @@index([nodeId])
}

model Attribution {
  id             String   @id @default(cuid())
  contentBlockId String
  sourceType     String // youtube | blog | community_map | pdf
  sourceName     String
  sourceUrl      String?
  sourceMapId    String? // credit to another learning map
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentBlock ContentBlock @relation(fields: [contentBlockId], references: [id], onDelete: Cascade)

  @@index([contentBlockId])
}

model MapComposition {
  id             String   @id @default(cuid())
  parentMapId    String
  componentMapId String
  componentVersion Int // pinned version of the component map
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parentMap    Map              @relation("parentMap", fields: [parentMapId], references: [id], onDelete: Cascade)
  componentMap Map              @relation("componentMap", fields: [componentMapId], references: [id])
  proposals    UpdateProposal[]

  @@unique([parentMapId, componentMapId])
  @@index([componentMapId])
}

model UpdateProposal {
  id            String         @id @default(cuid())
  compositionId String
  learnerId     String
  fromVersion   Int
  toVersion     Int
  status        ProposalStatus @default(pending)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  composition MapComposition @relation(fields: [compositionId], references: [id], onDelete: Cascade)
  learner     User           @relation("proposalLearner", fields: [learnerId], references: [id])

  @@index([compositionId])
  @@index([learnerId, status])
}

/** Private maps: a learner asks, the creator approves. Approved learners travel like it's public. */
model MapAccess {
  id        String       @id @default(cuid())
  mapId     String
  userId    String
  status    AccessStatus @default(pending)
  message   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  map  Map  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([mapId, userId])
  @@index([userId])
  @@index([mapId, status])
}

model Progress {
  id         String   @id @default(cuid())
  userId     String
  mapId      String
  nodeId     String
  mapVersion Int // stale-version writes rejected (eng E4)
  blocksDone Int      @default(0)
  mastered   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt // optimistic guard

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  Map  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId, mapId])
}

model CompanionThread {
  id        String   @id @default(cuid())
  userId    String
  mapId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  map      Map?      @relation(fields: [mapId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  role      String // user | assistant | tool
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread CompanionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

model GenerationJob {
  id          String    @id @default(cuid())
  kind        String // skeleton | section | enrich | embed | pdf_import
  status      JobStatus @default(queued)
  mapId       String?
  nodeId      String?
  blockIndex  Int?
  userId      String
  payload     Json
  // checkpoints: append-only progress records the client polls (eng A1)
  checkpoints Json      @default("[]")
  // lease (eng A2)
  claimedBy   String?
  heartbeatAt DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  // spend reservation (eng E2)
  reservedCostCents Int @default(0)
  actualCostCents   Int?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  map  Map?  @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id])

  @@index([status, createdAt])
  @@index([mapId, nodeId])
  @@index([userId])
}

model KbPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Embeddings live in a raw-SQL-managed table (pgvector column type),
// created in migrations: embedding vector(768) + ivfflat/hnsw index.
// Dimension tracked in env (EMBEDDINGS_DIMENSIONS) with re-embed job on provider switch.

model CoffeeChatRequest {
  id           String   @id @default(cuid())
  userId       String
  mapId        String
  availability String
  note         String?
  status       String   @default("open") // open | matched | done
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  Map  @relation(fields: [mapId], references: [id])

  @@index([status, createdAt])
}

enum InquiryKind {
  partnership
  volunteer
}

enum InquiryStatus {
  open
  closed
}

model Inquiry {
  id              String        @id @default(cuid())
  kind            InquiryKind
  name            String
  email           String
  organization    String?
  volunteerIntent String?
  context         String?
  message         String
  status          InquiryStatus @default(open)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, createdAt])
}
